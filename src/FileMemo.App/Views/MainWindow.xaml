<Window x:Class="FileMemo.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileMemo.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="文笺 FileMemo —— 签随文件走的超级便签" Height="760" Width="1180"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackdropFallbackBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!-- ============================================================
         自绘标题栏：WindowChrome 去掉系统边框，标题栏区域手动绘制。
         注意：AllowsTransparency 与 WindowChrome 互斥，本窗口不启用透明。
         所有标题栏内可交互控件必须 IsHitTestVisibleInChrome=True，否则会被当成拖动区。
         ============================================================ -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
        <conv:StateLabelToBrushConverter x:Key="StateLabelToBrush" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:PathToImageSourceConverter x:Key="PathToImage" />
        <conv:TagsToListConverter x:Key="TagsToList" />
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToTextConverter x:Key="BoolToKind" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 / 全局搜索 ============ -->
        <Grid Grid.Row="0">
            <!-- 背景独立一层：标题栏空白处仍可拖动窗口 -->
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1" />

            <Grid Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 应用标识 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconBase}" Data="{StaticResource IconApp}"
                          Stroke="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                          Margin="0,0,9,0" />
                    <TextBlock Text="文笺 FileMemo" Style="{StaticResource TextTitle}" VerticalAlignment="Center" />
                    <TextBlock Text="每份文件都值得一纸文笺" Style="{StaticResource TextCaption}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- 全局搜索（搜索框必须可点击，加 IsHitTestVisibleInChrome） -->
                <TextBox x:Name="GlobalSearch" Grid.Column="1" Width="420" HorizontalAlignment="Center"
                         Style="{StaticResource AppTextBox}"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="搜索" Style="{StaticResource TextButton}" Command="{Binding RunSearchCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddAnnotationCommand}"
                            Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconPlus}"
                                  Stroke="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="添加文件备注" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 窗口按钮组（最小化 / 最大化 / 关闭） -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top"
                            Margin="6,0,0,0">
                    <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}"
                            Click="Minimize_Click" ToolTip="最小化">
                        <Path x:Name="BtnMinIcon" Style="{StaticResource IconThin}"
                              Data="{StaticResource IconMinimize}"
                              Stroke="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}"
                            Click="MaximizeRestore_Click" ToolTip="最大化">
                        <Path x:Name="BtnMaxIcon" Style="{StaticResource IconThin}"
                              Data="{StaticResource IconMaximize}"
                              Stroke="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}"
                            Click="Close_Click" ToolTip="关闭">
                        <Path x:Name="BtnCloseIcon" Style="{StaticResource IconThin}"
                              Data="{StaticResource IconClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ 主体三栏 ============ -->
        <Grid Grid.Row="1" x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <!-- ②③ 列：进入「设置」分区时把右栏折叠，让设置面板占满这两列。
                     注意：ColumnDefinition 是 FrameworkContentElement（不是 FrameworkElement），
                     给它写 x:Name 不会生成代码字段，因此这里不命名，
                     统一通过 MainGrid.ColumnDefinitions[1]/[2] 在代码里索引访问。 -->
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Margin="20,18,20,10"
                               Style="{StaticResource TextH2}" />
                    <!-- 注意：不要在此设置 SelectedIndex，否则会在 InitializeComponent 阶段
                         触发 SelectionChanged，此时 VM 尚未就绪导致空引用。改到 Loaded 中设置。
                         Tag 承载分区名，SwitchPanels 依赖它，务必保留。 -->
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Notes">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconNote}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="便签 / 文件备注" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Clips">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconClipboard}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="剪贴板随记" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Tasks">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconCheckSquare}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="待办事项" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="FileTree">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconTree}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="文件树" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Search">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconSearch}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="搜索" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Recycle">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconTrash}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="回收站" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconSettings}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="设置" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 中间列表 -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- 统一记录列表（便签 + 文件/文件夹备注） -->
                    <DockPanel x:Name="MiddleNotes" Visibility="Visible">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,12,12,6">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewNoteCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconPlus}"
                                          Stroke="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="新建便签" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding AddAnnotationCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconPlus}"
                                          Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                    <TextBlock Text="文件备注" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Width="40" Margin="8,0,0,0"
                                    Command="{Binding RefreshCommand}" ToolTip="刷新">
                                <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconRefresh}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                        </StackPanel>
                        <ListBox x:Name="RecordList" ItemsSource="{Binding Records}"
                                 ItemContainerStyle="{StaticResource AppListBoxItem}"
                                 SelectedItem="{Binding SelectedRecord}"
                                 SelectionChanged="RecordList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding Badge}" FontSize="{StaticResource FontTiny}"
                                                           Foreground="{DynamicResource PrimaryBrush}" />
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                    Visibility="{Binding HasState, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="{StaticResource FontTiny}"
                                                           Foreground="{Binding StateLabel, Converter={StaticResource StateLabelToBrush}}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="20" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 剪贴板列表 -->
                    <DockPanel x:Name="MiddleClips" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="复制即记录，稍后可整理" Margin="16,14,16,6"
                                   Style="{StaticResource TextSecondary}" />
                        <ListBox ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}"
                                 ItemContainerStyle="{StaticResource AppListBoxItem}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding KindLabel}" Width="52"
                                                   Style="{StaticResource TextCaption}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="40"
                                                       Style="{StaticResource TextBody}" />
                                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0">
                                                <Run Text="{Binding SourceApp}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm:ss}'}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Path Grid.Column="2" Style="{StaticResource IconBase}" Data="{StaticResource IconPin}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" VerticalAlignment="Top" Margin="8,0,0,0" ToolTip="已固定" Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 待办列表 -->
                    <DockPanel x:Name="MiddleTasks" Visibility="Collapsed">
                        <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="12,12,12,6" Command="{Binding NewTaskCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconPlus}"
                                      Stroke="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="新建待办" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ListBox ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                 ItemContainerStyle="{StaticResource AppListBoxItem}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Done, Mode=TwoWay}"
                                                  Click="TaskCheck_Click"
                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextTitle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource TextCaption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DueLabel}"
                                                   Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 文件树（跨中右两栏，这里只用中间栏展示树） -->
                    <DockPanel x:Name="MiddleTree" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="带上下文覆盖层的文件地图"
                                   Margin="16,14,16,6" Style="{StaticResource TextSecondary}" />
                        <TreeView x:Name="FileTreeView" ItemsSource="{Binding FileTree}" Background="Transparent" BorderThickness="0"
                                  Margin="8,0" SelectedItemChanged="FileTree_SelectedItemChanged">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Height="30">
                                        <!-- 目录 / 文件用不同矢量图标（不再依赖 emoji 字符串） -->
                                        <Path VerticalAlignment="Center" Margin="0,0,8,0"
                                              Stroke="{DynamicResource TextSecondaryBrush}">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource IconBase}">
                                                    <Setter Property="Data" Value="{StaticResource IconNote}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource IconFolder}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   Style="{StaticResource TextBody}" />
                                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                Visibility="{Binding HasAnnotation, Converter={StaticResource BoolToVis}}">
                                            <Path Style="{StaticResource IconMini}" Data="{StaticResource IconNote}"
                                                  Stroke="{DynamicResource PrimaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding TaskBadge}" Margin="6,0,0,0"
                                                   Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <!-- 搜索结果 -->
                    <DockPanel x:Name="MiddleSearch" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" Text="搜索结果（文件 / 便签 / 剪贴板 / 待办）"
                                   Margin="16,14,16,6" Style="{StaticResource TextSecondary}" />
                        <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource AppListBoxItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{DynamicResource PrimarySoftBrush}"
                                                    CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Kind}" FontSize="{StaticResource FontTiny}"
                                                           Foreground="{DynamicResource PrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource TextCaption}" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="20" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 回收站 -->
                    <DockPanel x:Name="MiddleRecycle" Visibility="Collapsed">
                        <TextBlock Text="回收站（MVP 占位：删除的便签进入此处）" Margin="16,14" Style="{StaticResource TextSecondary}" />
                    </DockPanel>

                    <!-- 设置：二级菜单（左：分类导航，右：内容） -->
                    <DockPanel x:Name="MiddleSettings" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="196" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 二级菜单：设置分类导航 -->
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="设置" Margin="20,18,20,10"
                                               Style="{StaticResource TextH2}" />
                                    <ListBox x:Name="SettingsNav" Background="Transparent" BorderThickness="0"
                                             SelectionChanged="SettingsNav_SelectionChanged">
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="General">
                                            <TextBlock Text="通用" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Appearance">
                                            <TextBlock Text="外观主题" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Clipboard">
                                            <TextBlock Text="剪贴板" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Files">
                                            <TextBlock Text="文件与追踪" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Search">
                                            <TextBlock Text="搜索" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Hotkeys">
                                            <TextBlock Text="快捷键" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Sync">
                                            <TextBlock Text="同步与备份" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Intelligence">
                                            <TextBlock Text="高级功能" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="FloatingBall">
                                            <TextBlock Text="桌面悬浮图标" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="Privacy">
                                            <TextBlock Text="隐私与安全" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource NavItem}" Tag="About">
                                            <TextBlock Text="关于" VerticalAlignment="Center" />
                                        </ListBoxItem>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- 内容区 -->
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="20,16,20,24">
                                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">

                                <!-- ============ 外观主题画廊（XAML 静态声明，编译期验证） ============
                                     ★ 卡片内的预览色全部 Binding 主题定义的硬编码色值 + HexToBrush，
                                       绝不用 DynamicResource —— 否则 9 张卡片会被当前主题染成一模一样。
                                     ★ 卡片外框 / 文字用 DynamicResource，跟随当前主题变化。
                                     ★ 选中态交给 ListBox 的 IsSelected + DataTrigger。 -->
                                <TextBlock Text="外观主题" Style="{StaticResource TextTitle}" />
                                <TextBlock Text="点击卡片立即切换 · 共 11 款精选主题"
                                           Style="{StaticResource TextCaption}" Margin="0,2,0,12"
                                           TextWrapping="Wrap" />

                                <ListBox x:Name="ThemeGallery"
                                         Background="Transparent" BorderThickness="0" Cursor="Hand"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         SelectionMode="Single">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <!-- 列表项容器：清掉默认选中高亮，把选中态留给卡片自己的 DataTrigger -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <!-- 主题预览卡片 -->
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Card" Width="168" Height="132"
                                                    Margin="0,0,12,14"
                                                    CornerRadius="{StaticResource RadiusOverlay}"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="Transparent" BorderThickness="2"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- 顶部主色条 -->
                                                    <Border Grid.Row="0" Height="10"
                                                            CornerRadius="8,8,0,0"
                                                            Background="{Binding Preview1, Converter={StaticResource HexToBrush}}" />

                                                    <!-- 迷你界面预览：表面色底 + 文字色演示 + 主色小按钮 -->
                                                    <Border Grid.Row="1" Margin="12,10,12,4" CornerRadius="6"
                                                            Background="{Binding Preview2, Converter={StaticResource HexToBrush}}">
                                                        <StackPanel VerticalAlignment="Center" Margin="9,0">
                                                            <Border Height="5" Width="78" CornerRadius="2.5" HorizontalAlignment="Left"
                                                                    Background="{Binding Preview3, Converter={StaticResource HexToBrush}}" />
                                                            <Border Height="5" Width="52" Margin="0,4,0,0" CornerRadius="2.5" HorizontalAlignment="Left"
                                                                    Background="{Binding Preview3, Converter={StaticResource HexToBrush}}" Opacity="0.55" />
                                                            <Border Height="9" Width="34" Margin="0,6,0,0" CornerRadius="4.5" HorizontalAlignment="Left"
                                                                    Background="{Binding Preview1, Converter={StaticResource HexToBrush}}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 名称区：强调色圆点 + 名称 + 英文 · 深浅 -->
                                                    <StackPanel Grid.Row="2" Margin="12,4,12,10">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                     Fill="{Binding Preview4, Converter={StaticResource HexToBrush}}" />
                                                            <TextBlock Text="{Binding NameZh}" Style="{StaticResource TextTitle}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="14,2,0,0">
                                                            <TextBlock Text="{Binding NameEn}" Style="{StaticResource TextCaption}" />
                                                            <TextBlock Text=" · " Style="{StaticResource TextCaption}" />
                                                            <TextBlock Text="{Binding IsDark, Converter={StaticResource BoolToKind}, ConverterParameter=深色|浅色}"
                                                                       Style="{StaticResource TextCaption}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- 选中态：右上角主色勾选角标 -->
                                                    <Border x:Name="CheckBadge" Grid.RowSpan="3"
                                                            Width="24" Height="24"
                                                            CornerRadius="0,8,0,10"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Background="{DynamicResource PrimaryBrush}"
                                                            Visibility="Collapsed">
                                                        <Path Data="{StaticResource IconCheck}"
                                                              Stroke="{DynamicResource TextOnPrimaryBrush}"
                                                              StrokeThickness="1.6" Stretch="Uniform"
                                                              Width="12" Height="12"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <!-- 选中：主色描边 + 角标 -->
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                    <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <!-- 悬停：淡边框（未选中时） -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, ElementName=Card}" Value="True" />
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    </ListBox>

                                    </StackPanel><!-- /AppearancePanel -->

                                    <!-- 其余分类：由所选分类动态构建（见 MainWindow.xaml.cs） -->
                                    <StackPanel x:Name="SettingsPanel" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 右侧详情 -->
            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <!-- 统一编辑器：便签编辑 -->
                <DockPanel x:Name="DetailNote" Visibility="Collapsed" Margin="{StaticResource PanelPadding}">
                    <TextBlock DockPanel.Dock="Top" Text="便签编辑" Style="{StaticResource TextH2}" Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="标题" Style="{StaticResource TextSecondary}" />
                        <TextBox Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBox}" Margin="0,4,0,8" />
                        <TextBlock Text="标签（逗号分隔）" Style="{StaticResource TextSecondary}" />
                        <TextBox Text="{Binding SelectedNote.Tags, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBox}" Margin="0,4,0,8" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveNoteCommand}" />
                        <Button Content="删除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding DeleteNoteCommand}" />
                    </StackPanel>
                    <TextBox Text="{Binding SelectedNote.ContentMd, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource AppFontFamily}" FontSize="{StaticResource FontBody}"
                             Padding="12" BorderBrush="{DynamicResource BorderBrushSoft}" />
                </DockPanel>

                <!-- 统一编辑器：文件/文件夹备注 -->
                <DockPanel x:Name="DetailAnnotation" Visibility="Collapsed" Margin="{StaticResource PanelPadding}">
                    <TextBlock DockPanel.Dock="Top" Text="文件 / 文件夹备注" Style="{StaticResource TextH2}" Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="保存备注" Style="{StaticResource PrimaryButton}"
                                Click="SaveAnnotation_Click" />
                        <Button Content="删除备注" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Click="DeleteAnnotation_Click" />
                        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OpenFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconOpenExternal}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="打开文件" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="RevealFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconLocate}"
                                      Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="定位" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="AnnotationFileName" Style="{StaticResource TextTitle}" />
                        <TextBlock x:Name="AnnotationPath" Style="{StaticResource TextCaption}" Margin="0,2,0,8"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="状态" Style="{StaticResource TextSecondary}" />
                        <ComboBox x:Name="AnnotationStateBox" Style="{StaticResource AppComboBox}" Margin="0,4,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"
                                                 Fill="{Binding Converter={StaticResource StateLabelToBrush}}" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                   Foreground="{Binding Converter={StaticResource StateLabelToBrush}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="标签" Style="{StaticResource TextSecondary}" />
                        <TextBox x:Name="AnnotationTagsBox" Style="{StaticResource AppTextBox}" Margin="0,4,0,8" />
                        <TextBlock Text="为什么保存它（意图）" Style="{StaticResource TextSecondary}" />
                        <TextBox x:Name="AnnotationIntentBox" Style="{StaticResource AppTextBox}" Margin="0,4,0,8" />
                        <TextBlock Text="备注内容" Style="{StaticResource TextSecondary}" />
                        <TextBox x:Name="AnnotationContentBox" AcceptsReturn="True" Height="180"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12"
                                 BorderBrush="{DynamicResource BorderBrushSoft}" Margin="0,4,0,8" />
                        <TextBlock Text="时间线" Style="{StaticResource TextSecondary}" Margin="0,4,0,4" />
                        <ItemsControl x:Name="TimelineList" />
                    </StackPanel>
                </DockPanel>

                <!-- 剪贴板详情 -->
                <DockPanel x:Name="DetailClip" Visibility="Collapsed" Margin="{StaticResource PanelPadding}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="剪贴板详情" Style="{StaticResource TextH2}" VerticalAlignment="Center" />
                        <Path Style="{StaticResource IconBase}" Data="{StaticResource IconPin}" Margin="8,0,0,0" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" VerticalAlignment="Center" ToolTip="当前项已固定" Visibility="{Binding SelectedClip.Pinned, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="转为便签" Style="{StaticResource PrimaryButton}" Command="{Binding ConvertClipToNoteCommand}" />
                        <Button Content="固定/取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding PinClipCommand}" />
                        <Button Content="删除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding DeleteClipCommand}" />
                    </StackPanel>
                    <Grid>
                        <TextBox Text="{Binding SelectedClip.Content}" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12"
                                 BorderBrush="{DynamicResource BorderBrushSoft}"
                                 Visibility="{Binding SelectedClip.IsImage, Converter={StaticResource InverseBoolToVis}}" />
                        <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="{StaticResource BorderThin}"
                                CornerRadius="{StaticResource RadiusCard}" Background="{DynamicResource SurfaceAltBrush}"
                                Visibility="{Binding SelectedClip.IsImage, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding SelectedClip.ImagePath, Converter={StaticResource PathToImage}}"
                                   Stretch="Uniform" Margin="8" />
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- 待办详情 -->
                <DockPanel x:Name="DetailTask" Visibility="Collapsed" Margin="{StaticResource PanelPadding}">
                    <TextBlock DockPanel.Dock="Top" Text="待办详情" Style="{StaticResource TextH2}" Margin="0,0,0,12" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTaskCommand}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBox Text="{Binding SelectedTask.Title, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource AppTextBox}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="描述" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                            <Button Content="插入图片" Style="{StaticResource TextButton}"
                                    HorizontalAlignment="Right" Click="InsertTaskImage_Click" />
                        </Grid>
                        <TextBox x:Name="TaskDescBox"
                                 Text="{Binding SelectedTask.Description, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="120" TextWrapping="Wrap" Padding="10"
                                 BorderBrush="{DynamicResource BorderBrushSoft}" Margin="0,4,0,8" />
                        <ItemsControl ItemsSource="{Binding SelectedTask.ImagePaths}" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="{StaticResource BorderThin}"
                                            CornerRadius="{StaticResource RadiusCard}" Margin="0,0,0,6"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <Image Source="{Binding Converter={StaticResource PathToImage}}"
                                               Stretch="Uniform" MaxHeight="180" Margin="4" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="提醒时间（点输入框选日期、点预设快速设定，也可直接填写）"
                                   Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="+15 分钟" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                    Tag="15" Click="RemindPreset_Click" />
                            <Button Content="+1 小时" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                    Tag="60" Click="RemindPreset_Click" />
                            <Button Content="今晚 20:00" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                    Tag="tonight" Click="RemindPreset_Click" />
                            <Button Content="明天 09:00" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                                    Tag="tomorrow" Click="RemindPreset_Click" />
                            <Button Content="清除" Style="{StaticResource TextButton}" Margin="0,0,6,6"
                                    Tag="clear" Click="RemindPreset_Click" />
                        </WrapPanel>
                        <Grid Margin="0,0,0,8">
                                <TextBox x:Name="RemindTextBox"
                                         Text="{Binding SelectedTask.RemindInput, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource AppTextBox}"
                                         PreviewMouseLeftButtonDown="RemindTextBox_PreviewMouseLeftButtonDown"
                                         ToolTip="点击输入框弹出日历选择日期；格式 yyyy-MM-dd HH:mm，留空则不提醒" />
                                <Popup x:Name="RemindPopup" Placement="MousePoint"
                                       StaysOpen="True"
                                       AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                            CornerRadius="8" Padding="4"
                                            Effect="{DynamicResource ShadowPopup}">
                                        <Calendar x:Name="RemindCalendar" FontSize="22"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  Background="Transparent" BorderThickness="0"
                                                  SelectedDatesChanged="RemindCalendar_SelectedDatesChanged" />
                                    </Border>
                                </Popup>
                            </Grid>
                        <TextBlock Text="负责人 / 截止时间 / 优先级由数据模型承载（v1.0 简化编辑）"
                                   Style="{StaticResource TextCaption}" />
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- 文件树 / 搜索 / 设置 详情占位 -->
                <DockPanel x:Name="DetailEmpty" Visibility="Collapsed" Margin="{StaticResource PanelPadding}">
                    <TextBlock Text="请在左侧列表中选择一项查看详情" Style="{StaticResource TextSecondary}" />
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Margin="16,0" VerticalAlignment="Center"
                       Style="{StaticResource TextCaption}" />
        </Border>
    </Grid>
</Window>
