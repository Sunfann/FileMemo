<Window x:Class="FileMemo.App.Views.QuickTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速待办" Height="352" Width="440"
        WindowStartupLocation="CenterScreen" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}">
    <!-- 悬浮图标「待办」单击呼出的快速待办录入框（Ctrl+Enter 保存 / Esc 关闭） -->
    <Border Background="{DynamicResource FloatSurfaceBrush}" CornerRadius="{StaticResource RadiusOverlay}" Padding="16"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="{StaticResource BorderThin}"
            Effect="{DynamicResource ShadowPopup}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="快速待办" Style="{StaticResource TextTitle}" VerticalAlignment="Center" />
                <Button x:Name="PinBtn" Style="{StaticResource CaptionButton}" HorizontalAlignment="Right"
                        Width="28" Height="28" ToolTip="固定窗口（置顶，不随批量收纳 / 最小化）" Click="Pin_Click">
                    <Path x:Name="PinIcon" Style="{StaticResource IconBase}" Data="{StaticResource IconPin}"
                          Stroke="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="关闭 (Esc)" Style="{StaticResource SecondaryButton}" Click="Close_Click" />
                <Button Content="添加" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Add_Click" />
            </StackPanel>
            <StackPanel>
                <TextBox x:Name="TitleBox" Padding="10" Height="84" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="{DynamicResource BorderBrushSoft}"
                         FontSize="{StaticResource FontBody}"
                         ToolTip="输入待办内容，Ctrl+Enter 保存" />

                <TextBlock Text="提醒时间（可选，点一下即可）" Style="{StaticResource TextCaption}" Margin="0,10,0,4" />
                <WrapPanel>
                    <Button Content="+15 分钟" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                            Tag="15" Click="Preset_Click" />
                    <Button Content="+1 小时" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                            Tag="60" Click="Preset_Click" />
                    <Button Content="今晚 20:00" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                            Tag="tonight" Click="Preset_Click" />
                    <Button Content="明天 09:00" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                            Tag="tomorrow" Click="Preset_Click" />
                    <Button Content="明天此时" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                            Tag="tomorrownow" Click="Preset_Click" />
                    <Button Content="清除" Style="{StaticResource TextButton}" Margin="0,0,6,6"
                            Tag="clear" Click="Preset_Click" />
                </WrapPanel>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="RemindDate" Grid.Column="0" VerticalContentAlignment="Center"
                                FontFamily="{StaticResource AppFontFamily}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <ComboBox x:Name="RemindHour" Width="68" Style="{StaticResource AppComboBox}" />
                        <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox x:Name="RemindMin" Width="68" Style="{StaticResource AppComboBox}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="RemindPreview" Style="{StaticResource TextCaption}"
                           Margin="0,8,0,0" Text="未设置提醒" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
