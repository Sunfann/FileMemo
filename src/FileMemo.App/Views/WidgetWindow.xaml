<Window x:Class="FileMemo.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文笺 FileMemo · 桌面速览" Height="440" Width="320"
        WindowStartupLocation="Manual" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- 独立桌面悬浮窗：可拖拽、置顶、贴边、折叠（需求 3.8） -->
    <Border Background="{DynamicResource FloatSurfaceBrush}" CornerRadius="{StaticResource RadiusOverlay}" Padding="14"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="{StaticResource BorderThin}"
            Effect="{DynamicResource ShadowPopup}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="桌面速览" Style="{StaticResource TextTitle}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Style="{StaticResource CaptionButton}"
                        Width="30" Height="28" Click="Close_Click" ToolTip="关闭">
                    <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconClose}"
                          Stroke="{DynamicResource TextPrimaryBrush}" />
                </Button>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource PrimaryButton}" Click="QuickNote_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconPlus}"
                              Stroke="{DynamicResource TextOnPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="快速便签" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Clipboard_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconClipboard}"
                              Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="剪贴板" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="今日待办" Style="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="最近剪贴板" Style="{StaticResource TextSecondary}" Margin="0,12,0,4" />
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="36"
                                                   Style="{StaticResource TextBody}" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}"
                                                   Style="{StaticResource TextCaption}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
