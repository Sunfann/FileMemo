<Window x:Class="FileMemo.App.Views.ClipboardPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板随记" Height="520" Width="520"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{DynamicResource SurfaceBrush}">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource AppTextBox}"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="搜索剪贴板内容 / 来源应用" />
            <Button x:Name="PinBtn" Grid.Column="1" Style="{StaticResource CaptionButton}" Margin="8,0,0,0"
                    Width="30" Height="30" ToolTip="固定窗口（置顶，不随批量收纳 / 最小化）"
                    Click="WindowPin_Click">
                <Path x:Name="PinIcon" Style="{StaticResource IconBase}" Data="{StaticResource IconPin}"
                      Stroke="{DynamicResource TextSecondaryBrush}" />
            </Button>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="转为便签" Style="{StaticResource PrimaryButton}" Click="ToNote_Click" />
            <Button Content="固定/取消" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Pin_Click" />
            <Button Content="删除" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Delete_Click" />
            <Button Content="复制" Style="{StaticResource TextButton}" Margin="8,0,0,0" Click="Copy_Click" />
        </StackPanel>
        <ListBox x:Name="ClipList" Background="Transparent" BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}" />
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding KindLabel}" Width="52"
                                   Style="{StaticResource TextCaption}" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="44"
                                       Style="{StaticResource TextBody}" />
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0">
                                <Run Text="{Binding SourceApp}" /><Run Text=" · " />
                                <Run Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd HH:mm:ss}'}" />
                            </TextBlock>
                        </StackPanel>
                        <Path Grid.Column="2" Style="{StaticResource IconSmall}" Data="{StaticResource IconPin}"
                              Stroke="{DynamicResource PrimaryBrush}" VerticalAlignment="Top"
                              Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
