<Window x:Class="FileMemo.App.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快速便签" Height="220" Width="440"
        WindowStartupLocation="CenterScreen" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}">
    <!-- 全局快捷键呼出的 Acrylic 浮层（此处用半透明纯色 + 阴影，Win10 友好降级） -->
    <Border Background="{DynamicResource FloatSurfaceBrush}" CornerRadius="{StaticResource RadiusOverlay}" Padding="16"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="{StaticResource BorderThin}"
            Effect="{DynamicResource ShadowPopup}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="快速便签" Style="{StaticResource TextTitle}" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="关闭 (Esc)" Style="{StaticResource SecondaryButton}" Click="Close_Click" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Save_Click" />
            </StackPanel>
            <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Padding="10"
                     BorderBrush="{DynamicResource BorderBrushSoft}"
                     FontSize="{StaticResource FontBody}" />
        </DockPanel>
    </Border>
</Window>
