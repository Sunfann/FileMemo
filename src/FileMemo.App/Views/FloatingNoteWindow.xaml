<Window x:Class="FileMemo.App.Views.FloatingNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileMemo.App.Converters"
        Title="文件备注" Height="480" Width="400"
        WindowStartupLocation="Manual" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnPreviewKeyDown">
    <!-- 快捷键呼出的文件/文件夹备注弹窗（需求 3.4.1 / 3.4.4 / 3.4.2）：
         快速编辑文字、状态、标签、意图，并支持粘贴/拖入图片；已备注过的自动回显。
         “完成”按钮保存后自动关闭弹窗。
         注意：拖动仅绑定在标题区(Header)，避免抢占 状态下拉框/图片/文本框 的鼠标操作。 -->
    <Window.Resources>
        <conv:StateLabelToBrushConverter x:Key="StateLabelToBrush" />
    </Window.Resources>
    <Border Background="{DynamicResource FloatSurfaceBrush}" CornerRadius="{StaticResource RadiusOverlay}" Padding="14"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="{StaticResource BorderThin}"
            Effect="{DynamicResource ShadowPopup}">
        <DockPanel>
            <!-- 头部（可拖动） -->
            <Grid x:Name="Header" DockPanel.Dock="Top" Background="Transparent"
                  Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock x:Name="FileNameText" Style="{StaticResource TextTitle}" />
                    <TextBlock x:Name="PathText" Style="{StaticResource TextCaption}"
                               TextWrapping="Wrap" MaxHeight="34" Margin="0,2,0,0" />
                    <TextBlock x:Name="FingerprintText" Style="{StaticResource TextCaption}"
                               Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0" />
                    <TextBlock x:Name="HeaderHint" Style="{StaticResource TextCaption}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="PinBtn" Style="{StaticResource CaptionButton}" Width="28" Height="28" Margin="0,0,2,0"
                            ToolTip="固定窗口（置顶，不随批量收纳 / 最小化）" Click="Pin_Click">
                        <Path x:Name="PinIcon" Style="{StaticResource IconSmall}" Data="{StaticResource IconPin}"
                              Stroke="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Width="30" Height="28"
                            Click="Close_Click" ToolTip="关闭">
                        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconClose}"
                              Stroke="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 底部按钮 -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="完成" Style="{StaticResource PrimaryButton}" Click="SaveAndClose_Click" />
                <Button Content="保存" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Save_Click" />
                <Button Content="删除备注" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Delete_Click" />
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Open_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconOpenExternal}"
                              Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="打开" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Reveal_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconLocate}"
                              Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="定位" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="主窗口" Style="{StaticResource TextButton}" Margin="8,0,0,0" Click="OpenMain_Click" />
            </StackPanel>

            <!-- 元数据编辑区 -->
            <StackPanel DockPanel.Dock="Top">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="状态" Style="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="StateBox" Grid.Column="1" Style="{StaticResource AppComboBox}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="{Binding Converter={StaticResource StateLabelToBrush}}" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                       Foreground="{Binding Converter={StaticResource StateLabelToBrush}}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
                </Grid>
                <TextBox x:Name="TagsBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,6"
                         ToolTip="标签（逗号分隔），例如：重要,合同" />
                <TextBox x:Name="IntentBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,6"
                         ToolTip="意图：为什么保存它" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource SecondaryButton}" Click="PasteImage_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconClipboard}"
                                  Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="粘贴图片" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="AddImage_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconSmall}" Data="{StaticResource IconImage}"
                                  Stroke="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="添加图片…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="可 Ctrl+V 粘贴 / 拖入图片" Style="{StaticResource TextCaption}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 图片缩略图区（点击缩略图可移除）；无图片时由代码隐藏 -->
            <Border x:Name="ImageStrip" DockPanel.Dock="Top" Margin="0,0,0,6"
                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="{StaticResource BorderThin}"
                    CornerRadius="{StaticResource RadiusCard}" Padding="4"
                    Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="88">
                    <WrapPanel x:Name="ImagePanel" Orientation="Horizontal" />
                </ScrollViewer>
            </Border>

            <!-- 正文 -->
            <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MinHeight="120" Padding="10"
                     BorderBrush="{DynamicResource BorderBrushSoft}"
                     FontSize="{StaticResource FontBody}"
                     ToolTip="备注内容（支持 Markdown）" />
        </DockPanel>
    </Border>
</Window>
