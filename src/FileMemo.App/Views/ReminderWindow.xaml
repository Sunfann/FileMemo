<Window x:Class="FileMemo.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办提醒" Height="196" Width="440"
        WindowStartupLocation="CenterScreen" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" FontFamily="{StaticResource AppFontFamily}">
    <!-- 待办到点提醒弹窗：稍后提醒 / 完成 / 知道了 -->
    <Border Background="{DynamicResource FloatSurfaceBrush}" CornerRadius="{StaticResource RadiusOverlay}" Padding="16"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="{StaticResource BorderThin}"
            Effect="{DynamicResource ShadowPopup}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Path Style="{StaticResource IconBase}" Data="{StaticResource IconCheckSquare}"
                      Stroke="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="待办提醒" Style="{StaticResource TextTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="SnoozeBtn" Content="稍后提醒 (10 分钟)" Style="{StaticResource SecondaryButton}" Click="Snooze_Click" />
                <Button Content="标记完成" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Done_Click" />
                <Button Content="知道了" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Close_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource TextTitle}" TextWrapping="Wrap" />
                <TextBlock x:Name="TimeText" Style="{StaticResource TextCaption}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
