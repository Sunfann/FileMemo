<!--
  初始主题色字典 —— 仅在 App.xaml 加载阶段到 ThemeManager.Initialize() 执行前起作用。

  为什么需要它：
    App.xaml 解析时会立即合并本文件，而 XAML 里所有颜色都是 {DynamicResource XxxBrush}。
    如果此时合并的字典里没有任何颜色键，首帧会因找不到资源而报错/显示异常。
    因此这里放一份「默认主题（DeskBox 深色）」的完整 31 键作为兜底。

  与 ThemeDictionaryBuilder 的关系：
    该文件由 C# 在运行时生成的字典**整体替换**（靠 ThemeMarker 标记键定位）。
    也就是说本文件的色值只在极短的启动瞬间被使用，随后即被 ThemeManager 按用户设置替换。
    修改主题色请改 Themes/ThemeCatalog.cs，不要改这里（这里只需与 DeskBoxDark 保持一致即可）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ★ 定位标记：ThemeManager 靠它识别「哪一项是主题色字典」。
         值会被替换为当前主题 Id，这里给一个占位值。

         注意：WPF 的 XAML 里**没有** x:String（那是 System.Xaml / WinUI 的写法），
         裸字符串资源必须用 sys:String（即 System.String），
         且 sys 前缀要绑定到 mscorlib。 -->
    <sys:String x:Key="ThemeMarker">deskboxdark</sys:String>

    <!-- ===== Color 令牌（4）===== -->
    <Color x:Key="ColorPrimary">#FF0078D4</Color>
    <Color x:Key="ColorPrimaryHover">#FF1A86E0</Color>
    <Color x:Key="ColorPrimaryPressed">#FF0067B8</Color>
    <Color x:Key="ColorPrimarySoft">#240078D4</Color>

    <!-- ===== 品牌主色（5）===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF0078D4" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF1A86E0" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF0067B8" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#240078D4" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFFFF" />

    <!-- ===== 语义色（4）===== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFCE100" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FF0078D4" />

    <!-- ===== 表面 / 交互（5）===== -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF252525" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="BgSelectedBrush" Color="#1F0078D4" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#20FFFFFF" />

    <!-- ===== 文字（3）===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA5A5A5" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF767676" />

    <!-- ===== 窗口 / 浮层（2）===== -->
    <SolidColorBrush x:Key="WindowBackdropFallbackBrush" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="FloatSurfaceBrush" Color="#E61F1F1F" />

    <!-- ===== 图谱（6）===== -->
    <SolidColorBrush x:Key="GraphLegendBrush1" Color="#FF0078D4" />
    <SolidColorBrush x:Key="GraphLegendBrush2" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="GraphLegendBrush3" Color="#FFFCE100" />
    <SolidColorBrush x:Key="GraphLegendBrush4" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="GraphCanvasBrush" Color="#FF191919" />
    <SolidColorBrush x:Key="GraphNodeStrokeBrush" Color="#FF3C3C3C" />

    <!-- ===== 阴影（2）===== -->
    <DropShadowEffect x:Key="ShadowPopup" BlurRadius="24" ShadowDepth="4"
                      Direction="270" Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="ShadowDialog" BlurRadius="28" ShadowDepth="8"
                      Direction="270" Opacity="0.55" Color="#000000" />

</ResourceDictionary>
