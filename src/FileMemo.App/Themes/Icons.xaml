<!--
  矢量图标库 —— Fluent 风格单色线框图标，统一 16×16 viewbox。

  用法：
      <Path Style="{StaticResource IconBase}"
            Data="{StaticResource IconSearch}"
            Stroke="{DynamicResource TextSecondaryBrush}" />

  约定：
  · Data 用 StaticResource（几何不变，无需随主题重求值）
  · Stroke 用 DynamicResource（可跟随主题 / 按钮状态换色）
  · 全部为线框风格（Stroke 描边，Fill 保持 null），线宽由 IconBase 统一给 1.4
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         图标基样式：只负责尺寸 / 线宽 / 线帽，颜色留给使用处覆盖
         ============================================================ -->
    <Style x:Key="IconBase" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- 小尺寸变体：用于行内点缀（14px） -->
    <Style x:Key="IconSmall" TargetType="Path" BasedOn="{StaticResource IconBase}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <!-- 大字重变体：用于窗口按钮等需要更清晰的位置 -->
    <Style x:Key="IconThin" TargetType="Path" BasedOn="{StaticResource IconBase}">
        <Setter Property="StrokeThickness" Value="1.1" />
    </Style>

    <!-- 迷你变体：用于徽标 / 胶囊标签内的极小点缀（11px，线更细） -->
    <Style x:Key="IconMini" TargetType="Path" BasedOn="{StaticResource IconBase}">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="StrokeThickness" Value="1.6" />
    </Style>

    <!-- ============================================================
         应用与导航图标
         ============================================================ -->

    <!-- 应用标识：文件夹 + 便签 -->
    <StreamGeometry x:Key="IconApp">M1.8,4.2 L6.2,4.2 L7.6,5.6 L14.2,5.6 L14.2,12.6 L1.8,12.6 Z M1.8,4.2 L1.8,3.2 L6.6,3.2 L8,4.6</StreamGeometry>

    <!-- 文件夹 -->
    <StreamGeometry x:Key="IconFolder">M1.8,4 L6,4 L7.4,5.4 L14.2,5.4 L14.2,12.4 L1.8,12.4 Z</StreamGeometry>

    <!-- 便签 / 文件备注：纸张 + 折角 -->
    <StreamGeometry x:Key="IconNote">M3.4,2.2 L9.8,2.2 L12.6,5 L12.6,13.8 L3.4,13.8 Z M9.8,2.2 L9.8,5 L12.6,5</StreamGeometry>

    <!-- 剪贴板 -->
    <StreamGeometry x:Key="IconClipboard">M6,3.4 L6,2 L10,2 L10,3.4 M4.2,3.4 L11.8,3.4 L11.8,14 L4.2,14 Z</StreamGeometry>

    <!-- 待办 / 勾选方框 -->
    <StreamGeometry x:Key="IconCheckSquare">M2.6,2.6 L13.4,2.6 L13.4,13.4 L2.6,13.4 Z M5.2,8.1 L7.2,10.1 L11,5.6</StreamGeometry>

    <!-- 文件树（三层结点） -->
    <StreamGeometry x:Key="IconTree">M4.2,2.8 L4.2,13.2 M4.2,6.2 L8.4,6.2 L8.4,4.2 M4.2,9.4 L8.4,9.4 L8.4,11.6 M8.4,4.2 L11.8,4.2 M8.4,11.6 L11.8,11.6</StreamGeometry>

    <!-- 搜索：放大镜 -->
    <StreamGeometry x:Key="IconSearch">M7,2.2 A4.8,4.8 0 1 1 7,11.8 A4.8,4.8 0 1 1 7,2.2 Z M10.6,10.6 L14.2,14.2</StreamGeometry>

    <!-- 回收站 -->
    <StreamGeometry x:Key="IconTrash">M2.8,4.4 L13.2,4.4 M6,4.4 L6,2.4 L10,2.4 L10,4.4 M4.4,4.4 L5.2,13.8 L10.8,13.8 L11.6,4.4 M6.8,6.8 L6.8,11.4 M9.2,6.8 L9.2,11.4</StreamGeometry>

    <!-- 设置：齿轮 -->
    <StreamGeometry x:Key="IconSettings">M8,5.4 A2.6,2.6 0 1 1 8,10.6 A2.6,2.6 0 1 1 8,5.4 Z M8,1.6 L8,3.4 M8,12.6 L8,14.4 M1.6,8 L3.4,8 M12.6,8 L14.4,8 M3.5,3.5 L4.8,4.8 M11.2,11.2 L12.5,12.5 M12.5,3.5 L11.2,4.8 M4.8,11.2 L3.5,12.5</StreamGeometry>

    <!-- ============================================================
         动作图标
         ============================================================ -->

    <!-- 关闭 ✕ -->
    <StreamGeometry x:Key="IconClose">M3.6,3.6 L12.4,12.4 M12.4,3.6 L3.6,12.4</StreamGeometry>

    <!-- 最小化 -->
    <StreamGeometry x:Key="IconMinimize">M2.6,8 L13.4,8</StreamGeometry>

    <!-- 最大化 -->
    <StreamGeometry x:Key="IconMaximize">M2.8,2.8 L13.2,2.8 L13.2,13.2 L2.8,13.2 Z</StreamGeometry>

    <!-- 还原（最大化状态下显示） -->
    <StreamGeometry x:Key="IconRestore">M4.8,4.8 L13.2,4.8 L13.2,13.2 L4.8,13.2 Z M2.8,10.6 L2.8,2.8 L10.6,2.8</StreamGeometry>

    <!-- 刷新 ↻ -->
    <StreamGeometry x:Key="IconRefresh">M13,8 A5,5 0 1 1 8.6,3.1 M8.6,3.1 L11.4,3.1 M8.6,3.1 L8.6,5.9</StreamGeometry>

    <!-- 加号 ＋ -->
    <StreamGeometry x:Key="IconPlus">M8,3.2 L8,12.8 M3.2,8 L12.8,8</StreamGeometry>

    <!-- 减号 － -->
    <StreamGeometry x:Key="IconMinus">M3.2,8 L12.8,8</StreamGeometry>

    <!-- 固定 📌 -->
    <StreamGeometry x:Key="IconPin">M8,1.8 L8,4 M5.4,4 L10.6,4 L9.6,8.2 L10.6,9.6 L5.4,9.6 L6.4,8.2 Z M8,9.6 L8,14.4</StreamGeometry>

    <!-- 图片 -->
    <StreamGeometry x:Key="IconImage">M2.6,3 L13.4,3 L13.4,13 L2.6,13 Z M2.6,10.6 L6.2,7.2 L9,10 L11,8 L13.4,10.4 M5.6,6.2 A0.9,0.9 0 1 1 5.6,6.21</StreamGeometry>

    <!-- 保存（软盘） -->
    <StreamGeometry x:Key="IconSave">M3,2.6 L10.6,2.6 L13.2,5.2 L13.2,13.4 L2.8,13.4 L2.8,2.6 Z M5.2,2.6 L5.2,6 L10.6,6 L10.6,2.6 M5.2,9 L10.8,9 L10.8,13.4 L5.2,13.4 Z</StreamGeometry>

    <!-- 删除（垃圾桶，与 IconTrash 同形，语义区分） -->
    <StreamGeometry x:Key="IconDelete">M3.2,4.2 L12.8,4.2 M6.2,4.2 L6.2,2.4 L9.8,2.4 L9.8,4.2 M4.8,4.2 L5.6,13.6 L10.4,13.6 L11.2,4.2</StreamGeometry>

    <!-- 勾 ✓ -->
    <StreamGeometry x:Key="IconCheck">M3.2,8.4 L6.6,11.8 L12.8,4.6</StreamGeometry>

    <!-- 叉 ✗（小，区别于 IconClose） -->
    <StreamGeometry x:Key="IconCross">M4.4,4.4 L11.6,11.6 M11.6,4.4 L4.4,11.6</StreamGeometry>

    <!-- 下拉箭头（ComboBox 用） -->
    <StreamGeometry x:Key="IconChevronDown">M4.4,6.4 L8,10 L11.6,6.4</StreamGeometry>

    <!-- 右向箭头（展开 / 导航用） -->
    <StreamGeometry x:Key="IconChevronRight">M6.4,4.4 L10,8 L6.4,11.6</StreamGeometry>

    <!-- 编辑（铅笔） -->
    <StreamGeometry x:Key="IconEdit">M10.6,2.6 L13.4,5.4 L5.6,13.2 L2.4,13.6 L2.8,10.4 Z M9.2,4 L12,6.8</StreamGeometry>

    <!-- 标签 -->
    <StreamGeometry x:Key="IconTag">M2.4,7.6 L7.6,2.4 L13.6,2.4 L13.6,8.4 L8.4,13.6 Z M10.6,5.4 A0.8,0.8 0 1 1 10.6,5.41</StreamGeometry>

    <!-- 外部打开 -->
    <StreamGeometry x:Key="IconOpenExternal">M8.4,2.6 L13.4,2.6 L13.4,7.6 M13.4,2.6 L7.6,8.4 M11,9.6 L11,13.4 L2.6,13.4 L2.6,5 L6.4,5</StreamGeometry>

    <!-- 定位 / 目标 -->
    <StreamGeometry x:Key="IconLocate">M8,5.6 A2.4,2.4 0 1 1 8,10.4 A2.4,2.4 0 1 1 8,5.6 Z M8,1.8 L8,4 M8,12 L8,14.2 M1.8,8 L4,8 M12,8 L14.2,8</StreamGeometry>

    <!-- 信息 -->
    <StreamGeometry x:Key="IconInfo">M8,2.2 A5.8,5.8 0 1 1 8,13.8 A5.8,5.8 0 1 1 8,2.2 Z M8,7.2 L8,11.4 M8,4.9 L8,5.1</StreamGeometry>

    <!-- 警告 -->
    <StreamGeometry x:Key="IconWarning">M8,2.4 L14,13.2 L2,13.2 Z M8,6.4 L8,9.6 M8,11.4 L8,11.6</StreamGeometry>

    <!-- 剪贴板详情用：复制 -->
    <StreamGeometry x:Key="IconCopy">M5.4,5.4 L5.4,2.6 L13.2,2.6 L13.2,10.4 L10.4,10.4 M2.8,5.4 L10.6,5.4 L10.6,13.2 L2.8,13.2 Z</StreamGeometry>

    <!-- 展开/折叠（面板分组用） -->
    <StreamGeometry x:Key="IconExpand">M4,6 L8,2.6 L12,6 M4,10 L8,13.4 L12,10</StreamGeometry>

</ResourceDictionary>
