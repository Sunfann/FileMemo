<Window x:Class="SuperNote.App.Views.AddAnnotationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加文件备注" Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <StackPanel Margin="20">
        <TextBlock Text="添加文件 / 文件夹备注" Style="{StaticResource TextH2}" Margin="0,0,0,4" />
        <TextBlock Text="支持资源管理器右键菜单、拖拽文件、Everything 结果直接添加"
                   Style="{StaticResource TextCaption}" Margin="0,0,0,12" />
        <TextBox x:Name="PathBox" Style="{StaticResource AppTextBox}" Margin="0,0,0,8"
                 ToolTip="完整路径，例如 D:\项目\合同.docx" />
        <StackPanel Orientation="Horizontal">
            <Button Content="浏览文件…" Style="{StaticResource SecondaryButton}" Click="BrowseFile_Click" />
            <Button Content="浏览文件夹…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseFolder_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
            <Button Content="添加" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
