<Window x:Class="SuperNote.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超级便签 · 桌面速览" Height="440" Width="320"
        WindowStartupLocation="Manual" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource AppFontFamily}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- 独立桌面悬浮窗：可拖拽、置顶、贴边、折叠（需求 3.8） -->
    <Border Background="#F2FFFFFF" CornerRadius="12" Padding="14"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
            Effect="{StaticResource ShadowPopup}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="桌面速览" Style="{StaticResource TextTitle}" />
                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource TextButton}"
                        Width="28" Padding="0" Click="Close_Click" />
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="＋ 快速便签" Style="{StaticResource PrimaryButton}" Click="QuickNote_Click" />
                <Button Content="剪贴板" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Clipboard_Click" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="今日待办" Style="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="最近剪贴板" Style="{StaticResource TextSecondary}" Margin="0,12,0,4" />
                    <ItemsControl x:Name="ClipList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="36"
                                                   Style="{StaticResource TextBody}" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}"
                                                   Style="{StaticResource TextCaption}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
