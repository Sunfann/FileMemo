<Window x:Class="SuperNote.App.Views.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="超级便签悬浮球"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="220" Height="220" FontFamily="{StaticResource AppFontFamily}">
    <!-- Canvas 无背景 → 仅绘制的球体参与命中测试，空白处点击可穿透 -->
    <Canvas x:Name="Stage" Width="220" Height="220" Background="{x:Null}" />
</Window>
